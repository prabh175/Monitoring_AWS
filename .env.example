# Copy to `.env` and `source .env` (or use direnv). Do not commit `.env`.
# Terraform picks up TF_VAR_* automatically.

# Required for most AWS applies (match an EC2 key pair in your account)
export TF_VAR_ssh_key_name="your-ec2-keypair-name"

# Optional: public Route53 hosted zone apex (same account as the VPC)
export TF_VAR_route53_public_zone_name="your-public-zone.example.com"

# Optional: absolute path to Consul Enterprise license on this machine (validated at plan; not uploaded by Terraform)
export TF_VAR_consul_enterprise_license_path="/absolute/path/to/license.hclic"

# Kubernetes: create/update the consul-enterprise-license secret (see scripts/k8s-consul-license-secret.sh)
export CONSUL_LICENSE_FILE="/absolute/path/to/license.hclic"
export CONSUL_NAMESPACE="consul"
