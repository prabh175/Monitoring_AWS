# Copy to terraform.tfvars (gitignored) or use: export TF_VAR_name=value
# See .env.example and docs/SECRETS-AND-LOCAL-CONFIG.md

aws_region   = "us-east-1"
project_name = "consul-mesh-demo"
node_count   = 2

# EC2 key pair name in this region (same for bastion and kind nodes).
ssh_key_name = "your-ec2-keypair-name"

enable_bastion          = true
bastion_ssh_cidr_blocks = ["203.0.113.50/32"] # replace with YOUR public IP /32
bastion_instance_type   = "t3.micro"

# Existing public hosted zone in this account. Creates dc1, dc2, ... (public + split-horizon private).
route53_public_zone_name = "your-public-hosted-zone.example.com"

# Optional VPC-only private zone (different apex than route53_public_zone_name).
# private_zone_domain = ""
