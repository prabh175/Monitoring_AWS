# Copy to terraform.tfvars (gitignored) or use: export TF_VAR_name=value
# See .env.example and docs/SECRETS-AND-LOCAL-CONFIG.md

aws_region   = "us-east-1"
project_name = "consul-mesh-demo"

# EC2 key pair name in this region (required when enable_bastion = true).
# ssh_key_name = "your-ec2-keypair-name"

# Bastion: disabled by default — not needed for EKS.
# Enable only if you add the VM datacenter (Step 7) and need SSH to private instances.
# enable_bastion          = true
# bastion_ssh_cidr_blocks = ["203.0.113.50/32"]   # your laptop public IP /32
# bastion_instance_type   = "t3.micro"

# Optional: existing public Route53 hosted zone. Creates a split-horizon private zone.
# A records for EKS LB endpoints are added separately after Consul Helm install.
# route53_public_zone_name = "your-zone.example.com"

# Optional: separate private-only Route53 zone attached to the VPC.
# private_zone_domain = ""
