# Server only: merge as e.g. /etc/consul.d/acl.hcl BEFORE first start, or follow
# https://developer.hashicorp.com/consul/docs/security/acl for bootstrap flows.
#
# Replace REPLACE_WITH_INITIAL_MANAGEMENT_TOKEN with a UUID (e.g. uuidgen).
# Helm uses default deny; for a first lab you may temporarily use default_policy = "allow"
# and tighten later (policies + intentions).

acl {
  enabled        = true
  default_policy = "deny"
  down_policy    = "extend-cache"

  tokens {
    initial_management = "REPLACE_WITH_INITIAL_MANAGEMENT_TOKEN"
  }
}
