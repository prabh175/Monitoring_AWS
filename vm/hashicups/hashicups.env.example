# Optional: only /etc/hashicups.env on VMs that need overrides.
#
# HashiCups east-west traffic uses Consul DNS (e.g. product-api.service.consul).
# Docker gets --dns <this host's private IP> from vm/hashicups/scripts/lib.sh so the
# local Consul agent answers *.service.consul for containers.
#
# Browsers do not use Consul DNS. If the frontend image uses NEXT_PUBLIC_* for
# client-side API calls from your laptop, set a reachable URL (public IP, LB, Route53):

# export HASHICUPS_PUBLIC_API_URL="http://<public-api-public-ip-or-dns>:8080"
