# Terraform — never commit root secrets or state
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.tfstate.lock.info
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local env (TF_VAR_*, CONSUL_LICENSE_FILE, etc.)
.env
.env.local
.env.*.local

# SSH / TLS private keys (never commit)
*.pem

# Consul / TLS material (generate certs under a local-only directory if needed)
*.hclic
*.hclic.*
license.hclic

# Exported Kubernetes secrets (peering tokens, etc.)
*peering*export*.yaml
*secret*export*.yaml

# OS / editor
.DS_Store
*.swp
*~
